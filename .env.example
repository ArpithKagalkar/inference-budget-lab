# Documentation only. Set these in your shell; .env is not auto-loaded.
ECONOMY_BASE_URL=http://127.0.0.1:8000/v1
ECONOMY_MODEL=your-economy-model
ECONOMY_API_KEY=
ECONOMY_INPUT_PER_MILLION=0.15
ECONOMY_OUTPUT_PER_MILLION=0.60
# For a local model, omit token prices and use a positive GPU-hour rate instead:
# ECONOMY_HOURLY_COST=1.00
# ECONOMY_REASONING_EFFORT=none
STRONG_BASE_URL=http://127.0.0.1:8001/v1
STRONG_MODEL=your-strong-model
STRONG_API_KEY=
STRONG_INPUT_PER_MILLION=2.50
STRONG_OUTPUT_PER_MILLION=10.00
# STRONG_HOURLY_COST=1.00
# STRONG_REASONING_EFFORT=none

# Optional for Qwen3 through Ollama's native structured-output endpoint.
# ECONOMY_OLLAMA_THINK=false
# STRONG_OLLAMA_THINK=false

# Hosted OpenAI pilot defaults (configure only after a paid-run preflight):
# ECONOMY_BASE_URL=https://api.openai.com/v1
# ECONOMY_MODEL=gpt-5.6-luna
# ECONOMY_INPUT_PER_MILLION=0.20
# ECONOMY_OUTPUT_PER_MILLION=1.20
# STRONG_BASE_URL=https://api.openai.com/v1
# STRONG_MODEL=gpt-5.6-terra
# STRONG_INPUT_PER_MILLION=2.00
# STRONG_OUTPUT_PER_MILLION=12.00
# ECONOMY_REASONING_EFFORT=none
# STRONG_REASONING_EFFORT=none

# External actions. GitHub remains restricted in code to the demo repository.
INFERENCEOPS_GITHUB_REPOSITORY=ArpithKagalkar/inferenceops-demo-support-service
# SLACK_WEBHOOK_URL=
