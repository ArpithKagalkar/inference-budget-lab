# Documentation only. Set these in your shell; .env is not auto-loaded.
ECONOMY_BASE_URL=http://127.0.0.1:8000/v1
ECONOMY_MODEL=your-economy-model
ECONOMY_API_KEY=
ECONOMY_INPUT_PER_MILLION=0.15
ECONOMY_OUTPUT_PER_MILLION=0.60
# For a local model, omit token prices and use a positive GPU-hour rate instead:
# ECONOMY_HOURLY_COST=1.00
# ECONOMY_REASONING_EFFORT=none
STRONG_BASE_URL=http://127.0.0.1:8001/v1
STRONG_MODEL=your-strong-model
STRONG_API_KEY=
STRONG_INPUT_PER_MILLION=2.50
STRONG_OUTPUT_PER_MILLION=10.00
# STRONG_HOURLY_COST=1.00
# STRONG_REASONING_EFFORT=none
